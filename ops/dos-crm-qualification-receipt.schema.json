{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docente-os.local/schemas/dos-crm-qualification-receipt-v1.json",
  "title": "Docente OS DOS-CRM Qualification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "exact_sha",
    "capability_ids",
    "environment",
    "scenarios",
    "automated_gates",
    "human_review",
    "findings",
    "evidence_refs",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "qualification_id": {
      "type": "string",
      "minLength": 1
    },
    "exact_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DOS-[A-Z0-9-]+$"
      }
    },
    "environment": {
      "type": "string",
      "enum": [
        "CI",
        "PREVIEW",
        "BETA",
        "RELEASE_CANDIDATE",
        "PRODUCTION"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "automated_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "NOT_APPLICABLE"
            ]
          },
          "run_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "browser": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_use": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FRICTION",
            "REWORK_REQUIRED",
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "PENDING",
            "NOT_REQUIRED"
          ]
        },
        "reviewed_exact_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "status",
          "summary"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "CLOSED",
              "ACCEPTED_EXTERNAL",
              "DEFERRED"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
